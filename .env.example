PORT=3000
BINANCE_REST_BASE=https://fapi.binance.com
BINANCE_WS_BASE=wss://fstream.binance.com/stream
UNIVERSE_SIZE=50
MIN_24H_QUOTE_VOLUME_USDT=10000000
PAPER_BALANCE_USDT=1000
PAPER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=2
PAPER_AUTO=false
RISK_PER_TRADE_PCT=1
MAX_DAILY_RISK_PCT=6
MAX_TOTAL_POSITIONS=6
MAX_MOMENTUM_POSITIONS=3
MAX_SCALPING_POSITIONS=3
COOLDOWN_MINUTES=15
MIN_CONFIRMED_SCORE=75

# Binance Futures Demo/Testnet (isolated from PAPER and LIVE)
BINANCE_TESTNET_REST_BASE=https://demo-fapi.binance.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_EXECUTION_ENABLED=false
BINANCE_TESTNET_AUTO_START=false
ALLOW_SERVERLESS_EXECUTION=false

# Binance USDⓈ-M LIVE (real account; disabled by default)
BINANCE_LIVE_REST_BASE=https://fapi.binance.com
