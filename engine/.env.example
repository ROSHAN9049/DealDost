# Safe default: no real Binance orders
TRADING_MODE=PAPER

# Virtual starting equity used for risk calculations
PAPER_EQUITY=10000

# Risk controls
RISK_PER_TRADE=0.005
MAX_POSITIONS=3
MAX_DAILY_LOSS=0.03
MIN_SIGNAL_SCORE=75
STOP_LOSS_PCT=0.008
REWARD_R=2
COOLDOWN_MS=900000

# LIVE mode only — keep these in the server/VPS secret store, never commit them
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
